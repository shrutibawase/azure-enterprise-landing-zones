# Local .terraform directories
**/.terraform/*
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, except sample
*.tfvars
!terraform.tfvars.example

# Ignore override files as they are usually used only locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include fake override files for testing
!example_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Terraform plan output files
*.tfplan
tfplan

# Ignore lock files in submodules
modules/**/.terraform.lock.hcl
