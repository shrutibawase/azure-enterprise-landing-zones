subscription_id  = "00000000-0000-0000-0000-000000000000"
tenant_id        = "11111111-1111-1111-1111-111111111111"
environment      = "prod"
primary_location = "eastus2"

resource_groups = {
  "rg-enterprise-network-prod" = {
    location = "eastus2"
    tags     = { "Tier" = "Networking", "CostCenter" = "Infra-101" }
  }
  "rg-enterprise-security-prod" = {
    location = "eastus2"
    tags     = { "Tier" = "Security", "CostCenter" = "Sec-202" }
  }
  "rg-enterprise-workloads-prod" = {
    location = "eastus2"
    tags     = { "Tier" = "Compute", "CostCenter" = "Apps-303" }
  }
  "rg-enterprise-monitoring-prod" = {
    location = "eastus2"
    tags     = { "Tier" = "Monitoring", "CostCenter" = "Ops-404" }
  }
}

vnet_address_space = ["10.100.0.0/16"]

subnets = {
  "GatewaySubnet" = {
    address_prefixes = ["10.100.0.0/24"]
  }
  "AzureFirewallSubnet" = {
    address_prefixes = ["10.100.1.0/24"]
  }
  "AppSubnet" = {
    address_prefixes                  = ["10.100.10.0/24"]
    service_endpoints                 = ["Microsoft.KeyVault", "Microsoft.Storage"]
    private_endpoint_network_policies = "Enabled"
  }
  "PrivateEndpointSubnet" = {
    address_prefixes                  = ["10.100.20.0/24"]
    private_endpoint_network_policies = "Disabled"
  }
}

nsg_rules = {
  "allow-https-inbound" = {
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "443"
    source_address_prefix      = "VirtualNetwork"
    destination_address_prefix = "*"
    description                = "Allow internal HTTPS traffic from VNet"
  }
  "deny-all-inbound-default" = {
    priority                   = 4096
    direction                  = "Inbound"
    access                     = "Deny"
    protocol                   = "*"
    source_port_range          = "*"
    destination_port_range     = "*"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
    description                = "Strict Zero-Trust default deny rule"
  }
}

custom_routes = {
  "force-all-internet-to-firewall" = {
    address_prefix         = "0.0.0.0/0"
    next_hop_type          = "VirtualAppliance"
    next_hop_in_ip_address = "10.100.1.4"
  }
}
